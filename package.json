{
  "name": "ten-count",
  "private": true,
  "version": "1.0.0",
  "description": "TEN COUNT — Championship Boxing. An original browser boxing game with a deterministic simulation core.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run assets:validate && tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "preview:qa": "vite preview",
    "serve": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b --force",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:sim": "vitest run tests/sim tests/determinism",
    "soak": "tsx tools/soak.ts",
    "soak:long": "tsx tools/soak.ts --bouts 300",
    "career:sim": "tsx tools/career-sim.ts",
    "assets:validate": "tsx tools/validate-content.ts",
    "fixture:replay": "tsx tools/replay-fixture.ts",
    "playtest:build": "tsx tools/single-file.ts",
    "balance:tune": "tsx tools/balance-tune.ts",
    "balance:certify": "tsx tools/soak.ts --certify",
    "release:audit": "tsx tools/release-audit.ts",
    "qa:screens": "tsx tools/qa-screens.ts",
    "qa:smoke": "tsx tools/qa-smoke.ts",
    "verify": "tsx tools/verify.ts",
    "clean": "rimraf dist coverage .vite tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@eslint/js": "9.37.0",
    "@types/node": "22.18.8",
    "eslint": "9.37.0",
    "playwright": "1.56.0",
    "rimraf": "6.0.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.0",
    "vite": "6.3.6",
    "vitest": "3.2.4"
  }
}
